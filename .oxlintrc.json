{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "ignorePatterns": ["dist/**", "node_modules/**", ".claude/**"],
  "overrides": [
    {
      "files": ["test/**"],
      "rules": {
        "consistent-function-scoping": "off",
        "no-await-in-loop": "off",
        "no-shadow": "off"
      }
    }
  ]
}
