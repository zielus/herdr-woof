// woof-acceptance: 2acb74f4d410
export function titleCase(text) {
  if (text.trim() === "") {
    return "";
  }
  return text
    .trim()
    .split(/\s+/)
    .map((word) => word.charAt(0).toUpperCase() + word.slice(1).toLowerCase())
    .join(" ");
}

