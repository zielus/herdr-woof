{
  "name": "herdr-woof",
  "version": "0.3.1",
  "description": "Multi-agent workflow engine for Herdr: plan, build, review, repair, every hand-off verified.",
  "keywords": [
    "herdr",
    "agents",
    "orchestration",
    "claude-code",
    "workflow",
    "sdk"
  ],
  "homepage": "https://github.com/zielus/herdr-woof#readme",
  "bugs": {
    "url": "https://github.com/zielus/herdr-woof/issues"
  },
  "license": "MIT",
  "author": "Tomasz Chmielarz (https://github.com/zielus)",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zielus/herdr-woof.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "packageManager": "bun@1.3.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "woof": "dist/cli.js"
  },
  "files": [
    "dist/",
    "plugin/claude/",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run build && bun x vitest run",
    "check:version": "bun run scripts/check-version.ts",
    "smoke:package": "bun run scripts/smoke-package.ts",
    "acceptance:collect": "node scripts/acceptance/collect.mjs",
    "release:preflight": "bun run scripts/release/preflight.ts",
    "changeset": "changeset",
    "version": "changeset version && bun run scripts/release/sync-version.ts && prettier --write CHANGELOG.md package.json plugin/claude/.claude-plugin/plugin.json",
    "prepublishOnly": "bun run build",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run check:version && bun run test && bun run smoke:package"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^22.18.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.3.0",
    "smol-toml": "^1.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
