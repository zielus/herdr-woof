{
  "name": "herdr-woof",
  "version": "0.0.0",
  "description": "Multi-agent orchestration for CLI coding agents on Herdr: durable TypeScript workflow graphs that run inside your live Claude Code session",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zielus/herdr-woof.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "woof": "./bin/woof",
    "woof-mcp": "./bin/woof-mcp",
    "woof-agent-mcp": "./bin/woof-agent-mcp"
  },
  "files": [
    "bin/",
    "src/",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun x vitest run",
    "test:e2e": "bun x vitest run --config vitest.e2e.config.ts",
    "test:all": "bun run test && bun run test:e2e",
    "check:version": "bun run scripts/check-version.ts",
    "gen:herdr-types": "bun run scripts/gen-herdr-types.ts",
    "smoke:package": "bun run scripts/smoke-package.ts",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run check:version && bun run test && bun run build && bun run smoke:package",
    "verify:full": "bun run verify && bun run test:e2e",
    "test:coverage": "bun x vitest run --coverage"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "@types/node": "^26.4.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "json-schema-to-typescript": "^16.0.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.3.0",
    "smol-toml": "^1.4.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
