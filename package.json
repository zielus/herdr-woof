{
  "name": "herdr-woof",
  "version": "0.0.0",
  "description": "SDK foundation for coordinating coding agents through Herdr.",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zielus/herdr-woof.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "bun@1.3.2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "woof": "./bin/woof"
  },
  "files": [
    "dist/",
    "bin/",
    "herdr-plugin.toml",
    "plugin/claude/",
    "README.md"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "bun run build && bun x vitest run",
    "check:version": "bun run scripts/check-version.ts",
    "smoke:package": "bun run scripts/smoke-package.ts",
    "verify": "bun run typecheck && bun run lint && bun run format:check && bun run check:version && bun run test && bun run build && bun run smoke:package"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.3.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
