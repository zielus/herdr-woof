{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    // Only so the shadcn CLI can resolve components.json's "@/*" aliases into
    // ui/src from the repository root; no file under include uses them.
    "paths": { "@/*": ["./ui/src/*"] }
  },
  "include": ["src", "scripts", "test"]
}
